# Must use 127.0.0.1, not "localhost" — Spotify's security requirements
# (as of Feb 2025) explicitly reject "localhost" as a redirect URI string,
# even though it resolves to the same machine as 127.0.0.1.
# Port must match vite.config.js exactly (server.port + strictPort).
# Default below assumes Vite's default port 5173 — if that's changed
# in vite.config.js, update this URI to match.
VITE_SPOTIFY_CLIENT_ID=your_client_id_here
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback